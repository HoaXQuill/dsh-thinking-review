{
  "name": "dsh-thinking-review",
  "version": "1.2.0",
  "description": "DSH 插件：先问清楚再动手的追问澄清开关 + 会话复盘写入长期记忆。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "clarify",
    "thinking",
    "review",
    "memory"
  ],
  "license": "MIT",
  "author": "HoaXQ",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client-smoke.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/HoaXQuill/dsh-thinking-review.git"
  },
  "homepage": "https://github.com/HoaXQuill/dsh-thinking-review#readme",
  "bugs": {
    "url": "https://github.com/HoaXQuill/dsh-thinking-review/issues"
  }
}
